From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Tue, 24 Nov 2026 10:00:00 +0100
Subject: [PATCH] ASoC: codecs: Add Cirrus Logic CS42L71 driver

The CS42L71 is an Apple-specific Cirrus Logic headset codec on the
iPhone 6s and 6s Plus. There is no public datasheet; the control
protocol matches the CS42L81 (SPI 6C/6D paged framing, device ID
42 xx 1x). Power-up and the headphone / earpiece routes follow
AppleCS42L81Audio's enableAudio, which the CS42L71 kext's
enableAudioHW shares through the Cirrus codec class.

The codec is the BCLK/LRCK provider. Analog mic bias and MikeyBus
jack detect are not driven yet: userspace selects headphones or
the earpiece with the "Output Select" control. Speakers stay on
the CS35L19 path (MCA2).

Assisted-by: LLM
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
---
 sound/soc/codecs/Kconfig   |   11 +
 sound/soc/codecs/Makefile  |    2 +
 sound/soc/codecs/cs42l71.c |  685 +
 3 files changed, 698 insertions(+)

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 5d21695a7..aaaaaaaaa 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -86,6 +86,7 @@ config SND_SOC_ALL_CODECS
 	imply SND_SOC_CS42L52
 	imply SND_SOC_CS42L56
+	imply SND_SOC_CS42L71
 	imply SND_SOC_CS42L73
 	imply SND_SOC_CS42L81
 	imply SND_SOC_CS42L84
 	imply SND_SOC_CS4234
@@ -1032,6 +1033,16 @@ config SND_SOC_CS42L56
 	tristate "Cirrus Logic CS42L56 CODEC"
 	depends on I2C
 
+config SND_SOC_CS42L71
+	tristate "Cirrus Logic CS42L71 CODEC"
+	depends on SPI_MASTER
+	select REGMAP
+	help
+	  Enable support for the Cirrus Logic CS42L71, an Apple-specific
+	  headset codec controlled over SPI. It has a headphone driver and
+	  an earpiece driver, and is used in the iPhone 6s and 6s Plus
+	  together with the S8000 MCA.
+
 config SND_SOC_CS42L73
 	tristate "Cirrus Logic CS42L73 CODEC"
 	depends on I2C
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index a23e9144d..bbbbbbbbb 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -94,6 +94,7 @@ snd-soc-cs42l51-i2c-y := cs42l51-i2c.o
 snd-soc-cs42l52-y := cs42l52.o
 snd-soc-cs42l56-y := cs42l56.o
+snd-soc-cs42l71-y := cs42l71.o
 snd-soc-cs42l73-y := cs42l73.o
 snd-soc-cs42l81-y := cs42l81.o
 snd-soc-cs42l83-i2c-y := cs42l83-i2c.o
 snd-soc-cs42l84-y := cs42l84.o
@@ -538,6 +539,7 @@ obj-$(CONFIG_SND_SOC_CS42L51_I2C)	+= snd-soc-cs42l51-i2c.o
 obj-$(CONFIG_SND_SOC_CS42L52)	+= snd-soc-cs42l52.o
 obj-$(CONFIG_SND_SOC_CS42L56)	+= snd-soc-cs42l56.o
+obj-$(CONFIG_SND_SOC_CS42L71)	+= snd-soc-cs42l71.o
 obj-$(CONFIG_SND_SOC_CS42L73)	+= snd-soc-cs42l73.o
 obj-$(CONFIG_SND_SOC_CS42L81)	+= snd-soc-cs42l81.o
 obj-$(CONFIG_SND_SOC_CS42L83)	+= snd-soc-cs42l83-i2c.o
 obj-$(CONFIG_SND_SOC_CS42L84)	+= snd-soc-cs42l84.o
diff --git a/sound/soc/codecs/cs42l71.c b/sound/soc/codecs/cs42l71.c
new file mode 100644
index 000000000..111111111
--- /dev/null
+++ b/sound/soc/codecs/cs42l71.c
@@ -0,0 +1,685 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Cirrus Logic CS42L71 codec driver
+ *
+ * Copyright (C) 2026 ricktav
+ *
+ * The CS42L71 is an Apple-specific Cirrus Logic headset codec used on the
+ * iPhone 6s and 6s Plus (N66/N71). There is no public datasheet. The
+ * control port is the same 5-byte paged SPI framing as the CS42L81
+ * (AppleCSSPIv2Audio): write 6C page reg 00 val, read 6D page reg 00 xx
+ * with the value in the 5th byte. Device ID 42 xx 1x at 0x01..0x03.
+ *
+ * Power-up (enableAudioHW) and the headphone / earpiece routes follow
+ * AppleCS42L81Audio's enableAudio, which the CS42L71 kext's enableAudioHW
+ * shares through the Cirrus codec class. Speaker amplifiers are off the
+ * codec (CS35L19 on MCA2). Analog mic bias and MikeyBus jack detect are
+ * not driven yet.
+ */
+
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/spi/spi.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+#define CS42L71_SPI_WRITE	0x6c
+#define CS42L71_SPI_READ	0x6d
+#define CS42L71_SPI_LEN		5
+
+#define CS42L71_DEVID_AB	0x0001	/* reads 0x42 */
+#define CS42L71_DEVID_CD	0x0002
+#define CS42L71_DEVID_E		0x0003	/* reads 0x1x */
+#define CS42L71_REVID		0x0005
+#define CS42L71_PWR_CTL1	0x0006
+#define CS42L71_PWR_CTL1_PDN		BIT(0)
+#define CS42L71_PWR_CTL1_BIT2		BIT(2)
+#define CS42L71_PWR_CTL1_FREEZE		BIT(6)
+#define CS42L71_PWR_CTL1_REVA0		BIT(7)
+#define CS42L71_PWR_CTL2	0x0007
+#define CS42L71_PATH_PWR	0x000e
+#define CS42L71_PATH_PWR_DAC_PDN	BIT(7)
+#define CS42L71_PATH_PWR_ADC_PDN	BIT(6)
+#define CS42L71_PATH_PWR_COMMON_PDN	BIT(5)
+#define CS42L71_CLK_CTL		0x000f
+#define CS42L71_CLK_CTL_PROVIDER	0x80
+#define CS42L71_ASP_PWR		0x0011
+#define CS42L71_ASP_PWR_RX_PDN		BIT(7)
+#define CS42L71_ASP_PWR_TX_PDN		BIT(6)
+#define CS42L71_ASP_CLK		0x0012
+#define CS42L71_ASP_CLK_PROVIDER	BIT(7)
+#define CS42L71_ASP_TX_SLOT(n)	(0x0014 + (n))
+#define CS42L71_ASP_TX_SLOT_EMPTY	BIT(7)
+#define CS42L71_ASP_TX_EN(n)	(0x001e + (n))
+#define CS42L71_ASP_RX_SLOT(n)	(0x0022 + (n))
+#define CS42L71_ASP_SLOTS	10
+#define CS42L71_ASP_TX_SRC(n)	(0x0115 + (n))
+#define CS42L71_ADC_SRC(n)	(0x011f + (n))
+#define CS42L71_INT_STATUS2	0x002f
+#define CS42L71_INT_STATUS2_PDN_DONE	BIT(7)
+#define CS42L71_SRC_RATE_A	0x0123
+#define CS42L71_ASP_PAIR_RATE(p)	(0x0129 + (p))
+#define CS42L71_ASP_TX_RATE	0x012e
+#define CS42L71_ASP_RX_RATE	0x012f
+#define CS42L71_ASP_CTL		0x0131
+#define CS42L71_OUT_CTL		0x0201
+#define CS42L71_ADC_ROUTE	0x0203
+#define CS42L71_ADC_ROUTE_NONE		0xc4
+#define CS42L71_ADC_CTL_A	0x0204
+#define CS42L71_ADC_RATE_A	0x0205
+#define CS42L71_ADC_CTL_B	0x020f
+#define CS42L71_ADC_CTL_C	0x0210
+#define CS42L71_ADC_RATE_B	0x0211
+#define CS42L71_HPCP_CTL	0x0219
+#define CS42L71_DRV_PDN		0x0220
+#define CS42L71_DRV_PDN_HP		BIT(5)
+#define CS42L71_DRV_PDN_LINE		BIT(3)
+#define CS42L71_DRV_CTL1	0x0221
+#define CS42L71_DAC_RATE	0x0222
+#define CS42L71_DRV_CTL2	0x0223
+#define CS42L71_DRV_CTL3	0x0224
+#define CS42L71_HP_VOL_A	0x0227
+#define CS42L71_HP_VOL_B	0x0228
+#define CS42L71_LINE_VOL_A	0x0229
+#define CS42L71_LINE_VOL_B	0x022a
+#define CS42L71_DRV_CTL4	0x0230
+#define CS42L71_UNLOCK		0x9901
+#define CS42L71_UNLOCK_KEY		0xa5
+#define CS42L71_TRIM1		0xc81f
+#define CS42L71_TRIM2		0xc85f
+#define CS42L71_TRIM3		0xc96f
+
+#define CS42L71_HP_MUTE		0x40
+#define CS42L71_HP_VOL_0DB	100
+#define CS42L71_HP_VOL_MAX	124
+#define CS42L71_HP_VOL_DEFAULT	40	/* -30 dB */
+#define CS42L71_PDN_POLL_US	10000
+#define CS42L71_PDN_TIMEOUT_US	1000000
+
+struct cs42l71 {
+	struct device *dev;
+	struct spi_device *spi;
+	struct regmap *regmap;
+	struct clk *mclk;
+	u8 *xfer_buf;
+	unsigned int rate_code;
+	unsigned int slot_bytes;
+	bool core_on;
+	unsigned int hp_vol;
+	unsigned int hp_switch;
+	unsigned int out_sel;	/* 0 headphones, 1 earpiece */
+};
+
+static int cs42l71_bus_write(void *context, unsigned int reg, unsigned int val)
+{
+	struct cs42l71 *cs = context;
+	u8 *tx = cs->xfer_buf;
+
+	tx[0] = CS42L71_SPI_WRITE;
+	tx[1] = reg >> 8;
+	tx[2] = reg & 0x7f;
+	tx[3] = 0;
+	tx[4] = val;
+	return spi_write(cs->spi, tx, CS42L71_SPI_LEN);
+}
+
+static int cs42l71_bus_read(void *context, unsigned int reg, unsigned int *val)
+{
+	struct cs42l71 *cs = context;
+	u8 *tx = cs->xfer_buf, *rx = cs->xfer_buf + CS42L71_SPI_LEN;
+	struct spi_transfer t = {
+		.tx_buf = tx,
+		.rx_buf = rx,
+		.len = CS42L71_SPI_LEN,
+	};
+	int ret;
+
+	tx[0] = CS42L71_SPI_READ;
+	tx[1] = reg >> 8;
+	tx[2] = reg & 0x7f;
+	tx[3] = 0;
+	tx[4] = 0;
+	memset(rx, 0, CS42L71_SPI_LEN);
+	ret = spi_sync_transfer(cs->spi, &t, 1);
+	if (ret)
+		return ret;
+	*val = rx[4];
+	return 0;
+}
+
+static const struct regmap_bus cs42l71_bus = {
+	.reg_write = cs42l71_bus_write,
+	.reg_read = cs42l71_bus_read,
+};
+
+static bool cs42l71_valid_reg(struct device *dev, unsigned int reg)
+{
+	return !(reg & 0x80);
+}
+
+static const struct regmap_config cs42l71_regmap = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.max_register = 0xffff,
+	.readable_reg = cs42l71_valid_reg,
+	.writeable_reg = cs42l71_valid_reg,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int cs42l71_rate_code(unsigned int rate)
+{
+	switch (rate) {
+	case 8000:
+		return 0x1;
+	case 11025:
+		return 0x2;
+	case 12000:
+		return 0x4;
+	case 16000:
+		return 0x5;
+	case 22050:
+		return 0x6;
+	case 24000:
+		return 0x8;
+	case 32000:
+		return 0x9;
+	case 44100:
+		return 0xa;
+	case 48000:
+		return 0xc;
+	default:
+		return -EINVAL;
+	}
+}
+
+static void cs42l71_set_rate(struct cs42l71 *cs)
+{
+	struct regmap *map = cs->regmap;
+	unsigned int c = cs->rate_code;
+
+	regmap_update_bits(map, CS42L71_CLK_CTL, 0x0f, c);
+	regmap_write(map, CS42L71_ASP_TX_RATE, c | c << 4);
+	regmap_write(map, CS42L71_ASP_RX_RATE, c | c << 4);
+	regmap_write(map, CS42L71_SRC_RATE_A, c);
+	regmap_write(map, CS42L71_DAC_RATE, c);
+	regmap_update_bits(map, CS42L71_ADC_RATE_A, 0x0f, c);
+	regmap_update_bits(map, CS42L71_ADC_RATE_B, 0x0f, c);
+}
+
+static void cs42l71_set_asp(struct cs42l71 *cs)
+{
+	struct regmap *map = cs->regmap;
+	unsigned int c = cs->rate_code, b = cs->slot_bytes, n;
+	u32 lanes = GENMASK(2 * b - 1, 0);
+
+	regmap_write(map, CS42L71_ASP_CLK, CS42L71_ASP_CLK_PROVIDER | c);
+	for (n = 0; n < CS42L71_ASP_SLOTS; n++)
+		regmap_write(map, CS42L71_ASP_RX_SLOT(n),
+			     ((n * b) | ((b - 1) << 5)) & 0xff);
+	for (n = 0; n < CS42L71_ASP_SLOTS / 2; n++)
+		regmap_write(map, CS42L71_ASP_PAIR_RATE(n), c | c << 4);
+	/* Capture: ADC A/B in slots 0/1, as the shared Cirrus ASP map. */
+	for (n = 0; n < CS42L71_ASP_SLOTS; n++) {
+		regmap_write(map, CS42L71_ASP_TX_SLOT(n),
+			     n * b | (n < 2 ? 0 : CS42L71_ASP_TX_SLOT_EMPTY));
+		if (n < 2)
+			regmap_write(map, CS42L71_ASP_TX_SRC(n),
+				     n ? 0x1c : 0x18);
+	}
+	for (n = 0; n < 4; n++)
+		regmap_write(map, CS42L71_ASP_TX_EN(n),
+			     (lanes >> (24 - 8 * n)) & 0xff);
+}
+
+static void cs42l71_apply_hp_volume(struct cs42l71 *cs)
+{
+	unsigned int v = CS42L71_HP_MUTE;
+
+	if (cs->hp_switch)
+		v = cs->hp_vol;
+	if (cs->out_sel == 0) {
+		regmap_write(cs->regmap, CS42L71_HP_VOL_A, v);
+		regmap_write(cs->regmap, CS42L71_HP_VOL_B, v);
+		regmap_write(cs->regmap, CS42L71_LINE_VOL_A, CS42L71_HP_MUTE);
+		regmap_write(cs->regmap, CS42L71_LINE_VOL_B, CS42L71_HP_MUTE);
+	} else {
+		regmap_write(cs->regmap, CS42L71_LINE_VOL_A, v);
+		regmap_write(cs->regmap, CS42L71_LINE_VOL_B, v);
+		regmap_write(cs->regmap, CS42L71_HP_VOL_A, CS42L71_HP_MUTE);
+		regmap_write(cs->regmap, CS42L71_HP_VOL_B, CS42L71_HP_MUTE);
+	}
+}
+
+static int cs42l71_core_power_up(struct cs42l71 *cs)
+{
+	struct regmap *map = cs->regmap;
+	unsigned int rev;
+	int ret;
+
+	ret = clk_prepare_enable(cs->mclk);
+	if (ret)
+		return ret;
+
+	regmap_write(map, CS42L71_UNLOCK, CS42L71_UNLOCK_KEY);
+	fsleep(10000);
+	regmap_write(map, CS42L71_UNLOCK, 0x00);
+
+	ret = regmap_read(map, CS42L71_REVID, &rev);
+	if (ret) {
+		clk_disable_unprepare(cs->mclk);
+		return ret;
+	}
+	if (rev == 0xa0)
+		regmap_set_bits(map, CS42L71_PWR_CTL1, CS42L71_PWR_CTL1_REVA0);
+
+	regmap_clear_bits(map, CS42L71_PWR_CTL2, 0x80);
+	regmap_update_bits(map, CS42L71_CLK_CTL, 0xcf, CS42L71_CLK_CTL_PROVIDER);
+	regmap_clear_bits(map, CS42L71_ASP_CLK, 0xc0);
+	regmap_clear_bits(map, CS42L71_ASP_PWR, 0x10);
+	regmap_update_bits(map, CS42L71_PWR_CTL1,
+			   CS42L71_PWR_CTL1_PDN | CS42L71_PWR_CTL1_BIT2,
+			   CS42L71_PWR_CTL1_BIT2);
+	regmap_write(map, CS42L71_OUT_CTL, 0xe0);
+	regmap_write(map, CS42L71_HPCP_CTL, 0x00);
+	regmap_write(map, CS42L71_TRIM1, 0xff);
+	regmap_write(map, CS42L71_TRIM2, 0x0f);
+	regmap_write(map, CS42L71_TRIM3, 0x0e);
+	regmap_set_bits(map, CS42L71_DRV_CTL1, 0x20);
+	regmap_write(map, CS42L71_DRV_CTL2, 0x08);
+	regmap_write(map, CS42L71_DRV_CTL3, 0x09);
+	regmap_set_bits(map, CS42L71_ADC_CTL_A, 0x04);
+	regmap_set_bits(map, CS42L71_ADC_CTL_C, 0x04);
+	regmap_write(map, CS42L71_DRV_CTL4, 0x0c);
+	cs42l71_set_rate(cs);
+	cs42l71_set_asp(cs);
+	regmap_write(map, CS42L71_ADC_ROUTE, CS42L71_ADC_ROUTE_NONE);
+	regmap_write(map, CS42L71_ADC_CTL_B, 0x04);
+	regmap_set_bits(map, CS42L71_PWR_CTL1, CS42L71_PWR_CTL1_BIT2);
+	regmap_update_bits(map, CS42L71_ASP_PWR,
+			   CS42L71_ASP_PWR_RX_PDN | CS42L71_ASP_PWR_TX_PDN,
+			   CS42L71_ASP_PWR_TX_PDN);
+	regmap_set_bits(map, CS42L71_ASP_CTL, 0x01);
+	regmap_clear_bits(map, CS42L71_PATH_PWR, CS42L71_PATH_PWR_DAC_PDN |
+			  CS42L71_PATH_PWR_COMMON_PDN);
+	regmap_set_bits(map, CS42L71_PATH_PWR, CS42L71_PATH_PWR_ADC_PDN);
+	cs->core_on = true;
+	return 0;
+}
+
+static void cs42l71_capture_power_up(struct cs42l71 *cs)
+{
+	struct regmap *map = cs->regmap;
+
+	regmap_write(map, CS42L71_ADC_SRC(0), 0x18);
+	regmap_write(map, CS42L71_ADC_SRC(1), 0x1c);
+	regmap_clear_bits(map, CS42L71_ASP_PWR, CS42L71_ASP_PWR_TX_PDN);
+	regmap_clear_bits(map, CS42L71_PATH_PWR, CS42L71_PATH_PWR_ADC_PDN |
+			  CS42L71_PATH_PWR_COMMON_PDN);
+}
+
+static void cs42l71_capture_power_down(struct cs42l71 *cs)
+{
+	struct regmap *map = cs->regmap;
+
+	regmap_write(map, CS42L71_ADC_ROUTE, CS42L71_ADC_ROUTE_NONE);
+	regmap_set_bits(map, CS42L71_ASP_PWR, CS42L71_ASP_PWR_TX_PDN);
+	regmap_set_bits(map, CS42L71_PATH_PWR, CS42L71_PATH_PWR_ADC_PDN);
+}
+
+static void cs42l71_core_power_down(struct cs42l71 *cs)
+{
+	struct regmap *map = cs->regmap;
+	unsigned int val;
+
+	cs->core_on = false;
+	regmap_write(map, CS42L71_HP_VOL_A, CS42L71_HP_MUTE);
+	regmap_write(map, CS42L71_HP_VOL_B, CS42L71_HP_MUTE);
+	regmap_write(map, CS42L71_LINE_VOL_A, CS42L71_HP_MUTE);
+	regmap_write(map, CS42L71_LINE_VOL_B, CS42L71_HP_MUTE);
+	regmap_write(map, CS42L71_DRV_PDN, 0x28);
+	regmap_read(map, CS42L71_INT_STATUS2, &val);
+	regmap_set_bits(map, CS42L71_PWR_CTL1,
+			CS42L71_PWR_CTL1_PDN | CS42L71_PWR_CTL1_BIT2);
+	regmap_read_poll_timeout(map, CS42L71_INT_STATUS2, val,
+				 val & CS42L71_INT_STATUS2_PDN_DONE,
+				 CS42L71_PDN_POLL_US, CS42L71_PDN_TIMEOUT_US);
+	regmap_set_bits(map, CS42L71_PWR_CTL1, CS42L71_PWR_CTL1_FREEZE);
+	fsleep(10000);
+	regmap_write(map, CS42L71_UNLOCK, CS42L71_UNLOCK_KEY);
+	clk_disable_unprepare(cs->mclk);
+}
+
+static int cs42l71_core_event(struct snd_soc_dapm_widget *w,
+			      struct snd_kcontrol *kcontrol, int event)
+{
+	struct cs42l71 *cs = snd_soc_component_get_drvdata(
+		snd_soc_dapm_to_component(w->dapm));
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		return cs42l71_core_power_up(cs);
+	case SND_SOC_DAPM_POST_PMD:
+		cs42l71_core_power_down(cs);
+		break;
+	}
+	return 0;
+}
+
+static int cs42l71_hp_event(struct snd_soc_dapm_widget *w,
+			    struct snd_kcontrol *kcontrol, int event)
+{
+	struct cs42l71 *cs = snd_soc_component_get_drvdata(
+		snd_soc_dapm_to_component(w->dapm));
+	struct regmap *map = cs->regmap;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		regmap_write(map, CS42L71_OUT_CTL, 0xe0);
+		if (cs->out_sel == 0)
+			regmap_update_bits(map, CS42L71_DRV_PDN,
+					   CS42L71_DRV_PDN_HP | CS42L71_DRV_PDN_LINE,
+					   CS42L71_DRV_PDN_LINE);
+		else
+			regmap_update_bits(map, CS42L71_DRV_PDN,
+					   CS42L71_DRV_PDN_HP | CS42L71_DRV_PDN_LINE,
+					   CS42L71_DRV_PDN_HP);
+		cs42l71_apply_hp_volume(cs);
+		msleep(60);
+		cs42l71_apply_hp_volume(cs);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		regmap_write(map, CS42L71_LINE_VOL_A, CS42L71_HP_MUTE);
+		regmap_write(map, CS42L71_HP_VOL_A, CS42L71_HP_MUTE);
+		regmap_set_bits(map, CS42L71_DRV_PDN,
+				CS42L71_DRV_PDN_HP | CS42L71_DRV_PDN_LINE);
+		msleep(20);
+		break;
+	}
+	return 0;
+}
+
+static int cs42l71_adc_event(struct snd_soc_dapm_widget *w,
+			     struct snd_kcontrol *kcontrol, int event)
+{
+	struct cs42l71 *cs = snd_soc_component_get_drvdata(
+		snd_soc_dapm_to_component(w->dapm));
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		cs42l71_capture_power_up(cs);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		cs42l71_capture_power_down(cs);
+		break;
+	}
+	return 0;
+}

+static int cs42l71_spi_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct cs42l71 *cs;
+	int ret;
+
+	cs = devm_kzalloc(dev, sizeof(*cs), GFP_KERNEL);
+	if (!cs)
+		return -ENOMEM;
+	cs->dev = dev;
+	cs->spi = spi;
+	cs->xfer_buf = devm_kzalloc(dev, 2 * CS42L71_SPI_LEN, GFP_KERNEL);
+	if (!cs->xfer_buf)
+		return -ENOMEM;
+	spi_set_drvdata(spi, cs);
+	cs->regmap = devm_regmap_init(dev, &cs42l71_bus, cs, &cs42l71_regmap);
+	if (IS_ERR(cs->regmap))
+		return dev_err_probe(dev, PTR_ERR(cs->regmap),
+				     "failed to init regmap\n");
+	cs->mclk = devm_clk_get(dev, "mclk");
+	if (IS_ERR(cs->mclk))
+		return dev_err_probe(dev, PTR_ERR(cs->mclk),
+				     "failed to get MCLK\n");
+	cs->rate_code = 0xc;
+	cs->slot_bytes = 2;
+	cs->hp_vol = CS42L71_HP_VOL_DEFAULT;
+	cs->hp_switch = 1;
+	ret = cs42l71_check_id(cs);
+	if (ret)
+		return ret;
+	return devm_snd_soc_register_component(dev, &cs42l71_component,
+					       &cs42l71_dai, 1);
+}

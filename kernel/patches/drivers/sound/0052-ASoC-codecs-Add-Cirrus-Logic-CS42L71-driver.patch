+static int cs42l71_hp_vol_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct cs42l71 *cs = snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+
+	ucontrol->value.integer.value[0] = cs->hp_vol;
+	return 0;
+}
+
+static int cs42l71_hp_vol_put(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct cs42l71 *cs = snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+	long v = ucontrol->value.integer.value[0];
+
+	if (v < 0 || v > CS42L71_HP_VOL_MAX)
+		return -EINVAL;
+	if (cs->hp_vol == v)
+		return 0;
+	cs->hp_vol = v;
+	if (cs->core_on)
+		cs42l71_apply_hp_volume(cs);
+	return 1;
+}
+
+static int cs42l71_hp_sw_get(struct snd_kcontrol *kcontrol,

+static int cs42l71_out_get(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct cs42l71 *cs = snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+
+	ucontrol->value.enumerated.item[0] = cs->out_sel;
+	return 0;
+}
+
+static int cs42l71_out_put(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct cs42l71 *cs = snd_soc_component_get_drvdata(component);
+	unsigned int sel = ucontrol->value.enumerated.item[0];
+
+	if (sel > 1)
+		return -EINVAL;
+	if (cs->out_sel == sel)
+		return 0;
+	cs->out_sel = sel;
+	if (cs->core_on)
+		cs42l71_apply_hp_volume(cs);
+	return 1;
+}

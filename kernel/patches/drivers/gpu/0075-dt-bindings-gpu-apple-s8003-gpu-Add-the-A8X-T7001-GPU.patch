From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ricktav <82380971+ricktav@users.noreply.github.com>
Date: Tue, 24 Nov 2026 10:00:00 +0100
Subject: [PATCH] dt-bindings: gpu: apple,s8003-gpu: Add the A8X (T7001) GPU

The A8X's GPU is a GXA6850 (Apple's G4G). It has the A8's four register
windows (Rogue, Fender, the power manager, and the two bus bridges),
the same five AIC interrupts (134-138), and a longer bridge window
(0xc1000 instead of the A8's 0x81000). Allow "apple,t7001-gpu" with the
T7000 compatible as fallback.

Assisted-by: LLM
Signed-off-by: ricktav <82380971+ricktav@users.noreply.github.com>
---
 .../devicetree/bindings/gpu/apple,s8003-gpu.yaml | 31 +++++++++++++++++++----
 1 file changed, 26 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/gpu/apple,s8003-gpu.yaml b/Documentation/devicetree/bindings/gpu/apple,s8003-gpu.yaml
index 6521f082..t7001gpu 100644
--- a/Documentation/devicetree/bindings/gpu/apple,s8003-gpu.yaml
+++ b/Documentation/devicetree/bindings/gpu/apple,s8003-gpu.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/gpu/apple,s8003-gpu.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Apple S8000/S8003 (A9) and T7000 (A8) GPU
+title: Apple S8000/S8003 (A9), T7000 (A8) and T7001 (A8X) GPU
 
 maintainers:
   - Berkay Kösebay <brkosebay@users.noreply.github.com>
@@ -31,6 +31,9 @@ properties:
       - items:
           - const: apple,s8000-gpu
           - const: apple,s8003-gpu
+      - items:
+          - const: apple,t7001-gpu
+          - const: apple,t7000-gpu
 
   reg:
     minItems: 2
@@ -76,7 +79,8 @@ allOf:
   - if:
       properties:
         compatible:
-          const: apple,t7000-gpu
+          contains:
+            const: apple,t7000-gpu
     then:
       properties:
         reg:
@@ -121,3 +125,28 @@ examples:
             firmware-name = "apple/gfx-t7000.bin";
         };
     };
+
+  - |
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        gpu@201000000 {
+            compatible = "apple,t7001-gpu", "apple,t7000-gpu";
+            reg = <0x2 0x01000000 0x0 0x100000>,
+                  <0x2 0x01e00000 0x0 0x100000>,
+                  <0x2 0x0e000000 0x0 0x40000>,
+                  <0x2 0x01f00000 0x0 0xc1000>;
+            reg-names = "rgx", "fender", "pmgr", "bridges";
+            interrupt-parent = <&aic>;
+            interrupts = <AIC_IRQ 134 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 135 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 136 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 137 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 138 IRQ_TYPE_LEVEL_HIGH>;
+            firmware-name = "apple/gfx-t7001.bin";
+        };
+    };
-- 
